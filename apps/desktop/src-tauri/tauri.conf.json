{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Sorvex",
	"version": "0.1.0",
	"identifier": "ai.sorvex.desktop",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Sorvex",
				"width": 1200,
				"height": 800,
				"minWidth": 820,
				"minHeight": 560,
				"decorations": false,
				"transparent": true,
				"shadow": true,
				"resizable": true
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
			"devCsp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["appimage", "deb"],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
	}
}
